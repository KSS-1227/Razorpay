# =============================================================
# Enterprise Compliance Intelligence Platform — Environment Config
# =============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to git.
# =============================================================


# -------------------------------------------------------------
# OPENAI (text, vision, and audio)
# Store this only on the backend. Do not add it to frontend/.env or VITE_ variables.
# -------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# Text LLM: entity extraction, relation building, RAG answers.
# gpt-4o-mini is fast and cheap for structured text tasks.
OPENAI_TEXT_MODEL=gpt-4o-mini

# Vision LLM: image understanding, PDF page rendering, visual entity extraction.
# Must be gpt-4o (or a gpt-4o variant) — gpt-4o-mini does not accept image input.
OPENAI_VISION_MODEL=gpt-4o

# -------------------------------------------------------------
# COCKROACHDB CLOUD (backend only)
# Required for durable workspace graph, vector retrieval, and agent memory.
# Apply backend/storage/migrations/001_cockroachdb_schema.sql to this cluster.
# -------------------------------------------------------------
COCKROACH_DATABASE_URL=postgresql://your_cockroach_user:your_cockroach_password@your-cluster-host:26257/defaultdb?sslmode=verify-full

# Optional legacy per-client overrides — leave unset to use the OPENAI_*_MODEL defaults above.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=


# -------------------------------------------------------------
# MULTIMODAL LLM (image understanding, visual entity extraction)
# MM_MODEL_NAME overrides OPENAI_VISION_MODEL when set explicitly.
# Leave unset to use gpt-4o (the default).
# -------------------------------------------------------------
MM_API_KEY=
MM_API_BASE=https://api.openai.com/v1
MM_MODEL_NAME=


# -------------------------------------------------------------
# EMBEDDING MODEL (semantic search over knowledge graph nodes)
# Can be a local path OR a HuggingFace model name.
# Local path (download once): ./models/all-MiniLM-L6-v2
# HuggingFace auto-download:  sentence-transformers/all-MiniLM-L6-v2
# -------------------------------------------------------------
EMBEDDING_MODEL_DIR=sentence-transformers/all-MiniLM-L6-v2


# -------------------------------------------------------------
# DIRECTORY PATHS (relative to project root)
# -------------------------------------------------------------
INPUT_PDF_PATH=data/input/
CACHE_PATH=data/cache
WORKING_DIR=data/working
OUTPUT_DIR=data/output
MMKG_NAME=example_mmkg


# -------------------------------------------------------------
# PROCESSING PARAMETERS
# -------------------------------------------------------------
USE_MINERU=false
ENTITY_EXTRACT_MAX_GLEANING=0
ENTITY_SUMMARY_MAX_TOKENS=500
SUMMARY_CONTEXT_MAX_TOKENS=10000


# -------------------------------------------------------------
# RETRIEVAL PARAMETERS
# -------------------------------------------------------------
RETRIEVAL_THRESHOLD=0.2


# -------------------------------------------------------------
# SUPABASE AUTH CONFIGURATION
# Get these from: https://supabase.com/dashboard → your project → Settings → API
# -------------------------------------------------------------
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret


# -------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins (no trailing slash)
# -------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------
# OPTIONAL AWS S3 DURABLE DOCUMENT STORAGE
# Default is local. Set to s3 in production after creating a private bucket
# and granting the runtime least-privilege access.
# -------------------------------------------------------------
DOCUMENT_STORAGE_BACKEND=local
AWS_REGION=ap-south-1
S3_DOCUMENT_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
